-- Análise de Dados e Agregações

-- A1
SELECT MAX(Preco_Unitario) AS Maior_Preco_Cat3 FROM produtos WHERE FK_Categoria = 3;

-- A2
SELECT MIN(Preco_Unitario) AS Menor_Preco_Cat2 FROM produtos WHERE FK_Categoria = 2;

-- A3
SELECT FK_Categoria, COUNT(*) AS Qtd_Produtos FROM produtos GROUP BY FK_Categoria;

-- B1
SELECT MAX(p.Preco_Unitario) AS Max_Vendido_SP
FROM vendas v
JOIN clientes c ON v.FK_Cliente = c.ID_Cliente
JOIN produtos p ON v.FK_Produto = p.ID_Produto
WHERE c.Cidade = 'São Paulo';

-- B2
SELECT SUM(Quantidade) AS Total_Produto_101 FROM vendas WHERE FK_Produto = 101;

-- B3
SELECT MAX(p.Preco_Unitario) AS Maior_Valor_Periodo
FROM vendas v
JOIN produtos p ON v.FK_Produto = p.ID_Produto
WHERE v.Data_Venda BETWEEN '2024-03-15' AND '2024-03-25';
